            { "value": "complex", "label": "Сложная" },
            { "value": "unknown", "label": "Не знаю" }
          ]
        }
      ]
    },
    {
      "id": "extras",
      "title": "Дополнительно",
      "fields": [
        {
          "id": "extras",
          "type": "multi",
          "label": "Дополнительные работы",
          "hint": "Отметьте всё, что нужно. Можно ничего не выбирать.",
          "required": false,
          "options": [
            { "value": "terrace", "label": "Терраса или веранда" },
            { "value": "engineering", "label": "Инженерные системы" },
            { "value": "interior", "label": "Внутренняя отделка" },
            { "value": "stove", "label": "Печь и дымоход", "showIf": { "field": "buildingType", "eq": "banya" } },
            { "value": "fireplace", "label": "Камин или печь", "showIf": { "field": "buildingType", "in": ["house", "other"] } },
            { "value": "design", "label": "Индивидуальный проект" }
