    {
      "id": "base",
      "title": "Фундамент и кровля",
      "fields": [
        {
          "id": "foundation",
          "type": "segmented",
          "label": "Тип фундамента",
          "hint": "Окончательный выбор зависит от грунта участка.",
          "required": true,
          "options": [
            { "value": "piles", "label": "Винтовые сваи" },
            { "value": "strip", "label": "Ленточный" },
            { "value": "slab", "label": "Плита" },
            { "value": "existing", "label": "Уже есть" },
            { "value": "unknown", "label": "Не знаю" }
          ]
        },
        {
          "id": "roof",
          "type": "segmented",
          "label": "Форма кровли",
          "required": true,
          "options": [
            { "value": "gable", "label": "Двускатная" },
