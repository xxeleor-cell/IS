          "options": [
            { "value": "frame", "label": "Каркас", "hint": "Без усадки, гибкая планировка" },
            { "value": "beam", "label": "Брус", "hint": "Профилированный или клеёный" },
            { "value": "log", "label": "Бревно", "hint": "Оцилиндрованное или рубленое" },
            { "value": "other", "label": "Другой материал", "hint": "Обсудим отдельно" },
            { "value": "consult", "label": "Нужна консультация", "hint": "Поможем выбрать" }
          ]
        }
      ]
    },
    {
      "id": "size",
      "title": "Размеры и этажность",
