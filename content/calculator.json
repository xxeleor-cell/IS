            { "value": "2", "label": "2 этажа" }
          ]
        }
      ]
    },
    {
      "id": "package",
      "title": "Комплектация",
      "fields": [
        {
          "id": "package",
          "type": "cards",
          "label": "Степень готовности",
          "hint": "Названия и состав комплектаций предварительные и будут уточнены.",
          "required": true,
          "options": [
            { "value": "shell", "label": "Коробка", "hint": "Стены, перекрытия и кровля" },
            { "value": "warm", "label": "Тёплый контур", "hint": "Закрытый утеплённый контур с окнами и дверями" },
            { "value": "turnkey", "label": "Под ключ", "hint": "С отделкой и инженерными системами" },
            { "value": "undecided", "label": "Пока не определились", "hint": "Обсудим варианты" }
